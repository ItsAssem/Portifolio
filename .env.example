# Environment Variables Template
# Copy this file to .env.local and add your Firebase credentials

# Firebase (Firestore) — get these from Firebase Console → Project settings → Your apps → Web app
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

VITE_APP_TITLE=Portfolio

# Optional: Profile image path (must exist in public/ folder, e.g. public/asem-pfp.png)
# VITE_PROFILE_IMAGE_URL=/asem-pfp.png

# Security Notes:
# - Never commit .env files to version control
# - Add .env.local to .gitignore
# - Add the same VITE_FIREBASE_* vars in Netlify → Site settings → Environment variables
# - Edit projects live in Firebase Console → Firestore → projects collection (no redeploy needed)
